# Finance App — environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# Web app session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-secret

# Telegram Bot token
# Get this from @BotFather on Telegram: /newbot -> copy the token shown
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token-from-botfather

# Comma-separated list of numeric Telegram user IDs allowed to use the bot.
# Find your numeric ID via @userinfobot on Telegram.
# Example: TELEGRAM_ALLOWED_IDS=123456789,987654321
TELEGRAM_ALLOWED_IDS=replace-with-your-telegram-user-id

# ---------------------------------------------------------------------------
# Local AI extraction (Telegram bot only — the web app never uses these)
#
# The bot turns your messages and receipt photos into expenses using a model
# running on this machine via Ollama. No cloud API, no API key.
#
#   Text          -> hermes3:8b
#   Receipt photo -> Apple Vision OCR (on-device, macOS) -> hermes3:8b
#
# Setup:  brew install ollama && ollama serve && ollama pull hermes3:8b
#
# Every value below is optional — these are the built-in defaults. Uncomment
# only what you want to change.
# ---------------------------------------------------------------------------

# Extraction backend: hermes | stub | vlm
#   hermes  Ollama + hermes3:8b. The default, and what the bot uses if unset.
#   stub    No model at all. First number in the message becomes the amount,
#           the rest the merchant, date is always today, category "Other".
#           Use this to run the bot without installing Ollama.
#   vlm     Contingency: skips OCR, sends the raw image to a vision model.
#           Needs `ollama pull qwen3-vl:4b`. Not the tested path.
#EXTRACTOR=hermes

# Where Ollama is listening.
#OLLAMA_BASE_URL=http://localhost:11434

# Model used by the `hermes` extractor (~4.7 GB).
#OLLAMA_MODEL=hermes3:8b

# Vision model — only read when EXTRACTOR=vlm.
#VLM_MODEL=qwen3-vl:4b
